{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "RESEND_API_KEY",
        "CONVEX_DEPLOYMENT",
        "CONVEX_URL",
        "GROQ_API_KEY",
        "GOOGLE_API_KEY",
        "INNGEST_EVENT_KEY",
        "INNGEST_SIGNING_KEY"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "@workspace/canvas#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@workspace/backend#build": {
      "dependsOn": ["^build"],
      "outputs": ["convex/_generated/**"]
    },
    "system-design-engine#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "workflow-engine#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "electron:dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:e2e:watch": {
      "cache": false,
      "persistent": true
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:ui": {
      "cache": false,
      "persistent": true
    }
  }
}
