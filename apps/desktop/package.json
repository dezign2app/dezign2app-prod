{
  "name": "desktop",
  "version": "0.0.1",
  "private": true,
  "author": "Dezign2App Team",
  "description": "D2A",
  "main": "dist-electron/main.js",
  "scripts": {
    "generate-icons": "node scripts/generate-icons.js",
    "dev": "wait-on -i 1000 http://localhost:46500/robots.txt && tsc -p tsconfig.electron.json && electron .",
    "build:electron": "node scripts/build.js",
    "build:electron:win": "node scripts/build.js --win",
    "build:electron:mac": "node scripts/build.js --mac",
    "build:electron:linux": "node scripts/build.js --linux",
    "build:electron:all": "node scripts/build.js --all",
    "build:electron:dir": "node scripts/build.js --dir",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^20.19.30",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@workspace/typescript-config": "workspace:*",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^34.5.1",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "typescript": "^5.9.3",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.dezign2app.desktop",
    "productName": "D2A",
    "icon": "build/icon.ico",
    "protocols": [
      {
        "name": "D2A",
        "schemes": [
          "dezign2app"
        ]
      }
    ],
    "asar": false,
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "subhash131",
        "repo": "blueprint"
      }
    ],
    "directories": {
      "output": "release"
    },
    "compression": "normal",
    "extraResources": [
      {
        "from": "../web/.next",
        "to": "web/.next",
        "filter": [
          "!cache/**",
          "!dev/**",
          "!diagnostics/**",
          "!**/*.map"
        ]
      },
      {
        "from": "../web/public",
        "to": "web/public"
      },
      {
        "from": "../web/package.json",
        "to": "web/package.json"
      },
      {
        "from": "../web/.env",
        "to": "web/.env"
      },
      {
        "from": "../web/node_modules",
        "to": "web/node_modules",
        "filter": [
          "!**/*.map",
          "!**/*.d.ts",
          "!**/*.md",
          "!**/test/**",
          "!**/tests/**",
          "!**/__tests__/**"
        ]
      }
    ],
    "files": [
      "dist-electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "D2A",
      "differentialPackage": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Development"
    }
  }
}
