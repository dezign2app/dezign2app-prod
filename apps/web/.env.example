# Convex
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud

# Better Auth
BETTER_AUTH_SECRET=your_32_char_secret_key_here
BETTER_AUTH_URL=http://localhost:46500

# Resend Email (Optional in dev, required in prod)
RESEND_API_KEY=re_...
EMAIL_FROM=onboarding@resend.dev

# Social Providers (Optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:46500
NEXT_PUBLIC_WORKFLOW_ENGINE_BASE_URL=http://localhost:3001

# Creem Payments
CREEM_API_KEY=creem_test_...

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

TEST_MODE=true  # Set to false for production

# System Design Engine
NEXT_PUBLIC_SYSTEM_DESIGN_ENGINE_URL=http://localhost:3002